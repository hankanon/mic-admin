# 后端 API 网关地址
# 开发态：sys-app 直连 sys-server（见 sys-app/.env），基座自身暂无后端调用，保留占位即可
VITE_API_BASE_URL=/api

# 子应用资源地址（开发态各子应用独立端口，需与对应 vite.config 的端口一致）
VITE_DOC_APP_URL=http://localhost:3001
VITE_SYS_APP_URL=http://localhost:3003

# 生产态示例（同域部署时改为真实地址）：
# VITE_API_BASE_URL=https://api.example.com
# VITE_DOC_APP_URL=https://admin.example.com/doc-app/
# VITE_SYS_APP_URL=https://admin.example.com/sys-app/
