{
  "name": "mic-admin",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:main": "pnpm --filter @mic/main-app dev",
    "dev:doc": "pnpm --filter @mic/doc-app dev",
    "dev:sys": "pnpm --filter @mic/sys-app dev",
    "dev:sys-server": "pnpm --filter @mic/sys-server dev",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:main": "pnpm --filter @mic/main-app build",
    "preview": "pnpm -r --parallel preview",
    "lint": "pnpm -r typecheck",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "element-plus": "^2.9.0",
    "axios": "^1.7.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "vue-tsc": "^2.2.0",
    "mitt": "^3.0.1"
  },
  "pnpm": {
    "overrides": {
      "vue": "^3.5.0",
      "vue-router": "^4.5.0",
      "pinia": "^2.3.0",
      "element-plus": "^2.9.0",
      "axios": "^1.7.0"
    }
  }
}
