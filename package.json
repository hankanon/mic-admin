{
  "name": "mic-admin",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:main": "pnpm --filter @mic/main-app dev",
    "dev:doc": "pnpm --filter @mic/doc-app dev",
    "dev:sys": "pnpm --filter @mic/sys-app dev",
    "dev:dashboard": "pnpm --filter @mic/dashboard-app dev",
    "dev:profile": "pnpm --filter @mic/profile-app dev",
    "dev:qa": "pnpm --filter @mic/qa-app dev",
    "dev:sys-server": "pnpm --filter @mic/server dev",
    "dev:client": "pnpm --parallel --filter \"@mic/*-app\" dev",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:main": "pnpm --filter @mic/main-app build",
    "preview": "pnpm -r --parallel preview",
    "lint": "pnpm -r typecheck",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.2",
    "vite": "8.1.5",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "pinia": "4.0.2",
    "element-plus": "2.14.3",
    "axios": "1.18.1",
    "@vitejs/plugin-vue": "6.0.8",
    "vue-tsc": "3.3.8",
    "mitt": "^3.0.1"
  }
}
